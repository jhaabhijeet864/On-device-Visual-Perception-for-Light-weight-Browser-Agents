{
  "manifest_version": 3,
  "name": "Visual Perception Browser Agent (SIH 26171)",
  "version": "1.0.0",
  "description": "On-device Visual Perception, Privacy Firewall & SOM Tagging for Light-weight Browser Agents",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage",
    "offscreen",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/service_worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content_script.js"],
      "css": ["src/styles/main.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/styles/*",
        "src/perception/*",
        "assets/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
