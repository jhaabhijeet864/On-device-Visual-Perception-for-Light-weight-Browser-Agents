{
  "manifest_version": 3,
  "name": "AegisEdge Privacy Agent",
  "version": "1.0",
  "description": "Privacy-preserving browser agent for ISRO SIH26171",
  "permissions": [
    "tabs",
    "offscreen",
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content_script.js"]
    }
  ],
  "action": {
    "default_popup": "ui/popup.html"
  },
  "offscreen": {
    "scripts": ["offscreen/offscreen.js"]
  }
}
